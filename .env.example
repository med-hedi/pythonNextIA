# Copier ce fichier en `.env` puis adapter. Ne jamais committer `.env`.
APP_ENVIRONMENT=local
APP_DEBUG=true
APP_LOG_LEVEL=INFO

# SQLite (par défaut) ou PostgreSQL :
APP_DATABASE_URL=sqlite+aiosqlite:///./app.db
# APP_DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
APP_DATABASE_ECHO=false

# Authentification JWT. OBLIGATOIRE en staging/production (32 caractères min.).
# Générer une valeur : openssl rand -hex 32
# APP_JWT_SECRET_KEY=
APP_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Liste JSON des origines autorisées (front-end) :
APP_CORS_ORIGINS=["http://localhost:3000"]
